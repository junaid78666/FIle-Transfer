# ─────────────────────────────────────────────────────────────
#  .env.example  –  Copy to .env and fill in real values
#  NEVER commit .env to version control
# ─────────────────────────────────────────────────────────────

# Flask core
FLASK_ENV=development
FLASK_DEBUG=1
SECRET_KEY=change-this-to-a-long-random-secret-key-in-production

# Database
# SQLite (default for development):
DATABASE_URL=sqlite:///file_transfer.db
# MySQL (for production, uncomment and fill):
# DATABASE_URL=mysql+pymysql://user:password@localhost/file_transfer_db

# File uploads
UPLOAD_FOLDER=uploads
MAX_CONTENT_LENGTH_MB=100

# Session
SESSION_COOKIE_SECURE=False
SESSION_COOKIE_HTTPONLY=True
PERMANENT_SESSION_LIFETIME_MINUTES=30

# WTF CSRF
WTF_CSRF_ENABLED=True
